{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emulsion",
  "version": "0.1.0",
  "identifier": "app.emulsion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emulsion",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#1c1b19",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Film looks for digital photos",
    "longDescription": "Emulsion develops your photos through a film stock, push or pull processing and a scanner profile, with halation, glow and grain.",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
